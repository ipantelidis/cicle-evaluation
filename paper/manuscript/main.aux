\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Macro-F1 against mean prompt tokens per LLM call (log scale), one panel per dataset. Each point is one method, retrieval variant and $k$ at the reference setting, averaged over six models and three seeds, with $k$ increasing along each line. Grey is few-shot prompting, blue CICLe, hollow markers Fixed and filled markers Per-Class retrieval. Horizontal lines are the base classifier and fine-tuned RoBERTa-base. Ohsumed Per-Class is $k = 1$ only. Bootstrap intervals are in Table~\ref {tab:main}.}}{6}{figure.caption.13}\protected@file@percent }
\newlabel{fig:main_tokens}{{1}{6}{Macro-F1 against mean prompt tokens per LLM call (log scale), one panel per dataset. Each point is one method, retrieval variant and $k$ at the reference setting, averaged over six models and three seeds, with $k$ increasing along each line. Grey is few-shot prompting, blue CICLe, hollow markers Fixed and filled markers Per-Class retrieval. Horizontal lines are the base classifier and fine-tuned RoBERTa-base. Ohsumed Per-Class is $k = 1$ only. Bootstrap intervals are in Table~\ref {tab:main}}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Narrowing rules under a long-tailed labelled pool on Yahoo Answers (top) and SST-5 (bottom), Per-Class retrieval. Left (a): CICLe minus few-shot, top-$m$, probability mass and marginal CP against the imbalance of the labelled pool, paired over six models, three seeds and $k \in \{1, 4\}$ (36 pairs per point) with 95\% bootstrap intervals, and the oracle set minus few-shot as the dashed ceiling. Right (b): per-class coverage of the candidate sets at 100$\times $ by class-frequency rank in the pool, mean over three seeds, with the $1 - \alpha $ line dotted. The test sample is the same at every imbalance level. Detailed version in Appendix~\ref {app:narrowing}.}}{6}{figure.caption.14}\protected@file@percent }
\newlabel{fig:main_narrowing}{{2}{6}{Narrowing rules under a long-tailed labelled pool on Yahoo Answers (top) and SST-5 (bottom), Per-Class retrieval. Left (a): CICLe minus few-shot, top-$m$, probability mass and marginal CP against the imbalance of the labelled pool, paired over six models, three seeds and $k \in \{1, 4\}$ (36 pairs per point) with 95\% bootstrap intervals, and the oracle set minus few-shot as the dashed ceiling. Right (b): per-class coverage of the candidate sets at 100$\times $ by class-frequency rank in the pool, mean over three seeds, with the $1 - \alpha $ line dotted. The test sample is the same at every imbalance level. Detailed version in Appendix~\ref {app:narrowing}}{figure.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main results. LLM rows are means over six models and three seeds, supervised rows over three seeds. $\Delta $ is CICLe minus few-shot in macro-F1 points pooled over all $k$, with its 95\% paired bootstrap interval over test instances and the number of (model, seed, $k$) cells. Bold marks intervals that exclude zero. Ohsumed Per-Class is run at $k = 1$ only. Tokens saved compare Per-Class CICLe with Per-Class few-shot prompting at equal $k$.}}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:main}{{2}{7}{Main results. LLM rows are means over six models and three seeds, supervised rows over three seeds. $\Delta $ is CICLe minus few-shot in macro-F1 points pooled over all $k$, with its 95\% paired bootstrap interval over test instances and the number of (model, seed, $k$) cells. Bold marks intervals that exclude zero. Ohsumed Per-Class is run at $k = 1$ only. Tokens saved compare Per-Class CICLe with Per-Class few-shot prompting at equal $k$}{table.caption.12}{}}
