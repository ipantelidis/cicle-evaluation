\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main results on five datasets. Zero-shot prompting lists all labels and no examples. Few-shot prompting adds $k$ retrieved examples. CICLe restricts the label list and the examples to the class-conditional conformal set ($\alpha = 0.05$) of a logistic regression on MiniLM embeddings, the same classifier as the MiniLM + LR row. Fixed retrieval places the $k$ most similar examples among the admissible classes, Per-Class the $k$ most similar of each admissible class. A: macro-F1 at $k = 4$, LLM rows averaged over six 3B to 8B models and three seeds, supervised rows over three seeds, small numbers the mean prompt tokens per LLM call. B: CICLe minus few-shot prompting in macro-F1 points, pooled over all $k$ (72 model, seed and $k$ cells, Ohsumed 36 and 18), with 95\% paired bootstrap intervals over test instances. Bold: interval excludes zero. Ohsumed Per-Class is run at $k = 1$ only (dagger). Tokens saved: Per-Class CICLe against Per-Class few-shot prompting, per LLM call.}}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:main}{{2}{7}{Main results on five datasets. Zero-shot prompting lists all labels and no examples. Few-shot prompting adds $k$ retrieved examples. CICLe restricts the label list and the examples to the class-conditional conformal set ($\alpha = 0.05$) of a logistic regression on MiniLM embeddings, the same classifier as the MiniLM + LR row. Fixed retrieval places the $k$ most similar examples among the admissible classes, Per-Class the $k$ most similar of each admissible class. A: macro-F1 at $k = 4$, LLM rows averaged over six 3B to 8B models and three seeds, supervised rows over three seeds, small numbers the mean prompt tokens per LLM call. B: CICLe minus few-shot prompting in macro-F1 points, pooled over all $k$ (72 model, seed and $k$ cells, Ohsumed 36 and 18), with 95\% paired bootstrap intervals over test instances. Bold: interval excludes zero. Ohsumed Per-Class is run at $k = 1$ only (dagger). Tokens saved: Per-Class CICLe against Per-Class few-shot prompting, per LLM call}{table.caption.14}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Supervised baselines against the LLM pipelines, macro-F1, balanced and long-tailed pools of 1,600 examples. LR: MiniLM with logistic regression. RoB$_{\mathrm  {B}}$, RoB$_{\mathrm  {L}}$: fine-tuned RoBERTa-base and -large. FS, CICLe: Per-Class, $k = 4$ (F: Fixed). Bold: best per row. Full version in Table~\ref {tab:baselines}.}}{7}{table.caption.15}\protected@file@percent }
\newlabel{tab:main_supervised}{{3}{7}{Supervised baselines against the LLM pipelines, macro-F1, balanced and long-tailed pools of 1,600 examples. LR: MiniLM with logistic regression. RoB$_{\mathrm {B}}$, RoB$_{\mathrm {L}}$: fine-tuned RoBERTa-base and -large. FS, CICLe: Per-Class, $k = 4$ (F: Fixed). Bold: best per row. Full version in Table~\ref {tab:baselines}}{table.caption.15}{}}
