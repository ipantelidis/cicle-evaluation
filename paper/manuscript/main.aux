\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Label renaming. Macro-F1 with the original class names and with every name replaced by a nonsense word (same mapping for all seeds), mean over six models and three seeds. $k = 0$ is the candidate set without examples. $\Delta $ = CICLe minus few-shot, paired over $k \in \{1, 4\}$ (36 pairs), with 95\% bootstrap intervals over test instances. The base classifier is unaffected by renaming, so the whole effect is on the LLM's use of the candidate list and the examples. FS = few-shot, PC = Per-Class. Ohsumed is Fixed only.}}{18}{table.caption.27}\protected@file@percent }
\newlabel{tab:relabel}{{8}{18}{Label renaming. Macro-F1 with the original class names and with every name replaced by a nonsense word (same mapping for all seeds), mean over six models and three seeds. $k = 0$ is the candidate set without examples. $\Delta $ = CICLe minus few-shot, paired over $k \in \{1, 4\}$ (36 pairs), with 95\% bootstrap intervals over test instances. The base classifier is unaffected by renaming, so the whole effect is on the LLM's use of the candidate list and the examples. FS = few-shot, PC = Per-Class. Ohsumed is Fixed only}{table.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Prompt robustness on seed 42. CICLe against few-shot prompting under the default prompt, an alternative prompt wording and random instead of similarity-based example retrieval, six small models, $k \in \{1, 4\}$. Cells are means over the 12 runs, and $\Delta $ is paired over the 1,000 instances and 12 cells with its 95\% bootstrap interval. Ohsumed is Fixed only.}}{18}{table.caption.28}\protected@file@percent }
\newlabel{tab:robust}{{9}{18}{Prompt robustness on seed 42. CICLe against few-shot prompting under the default prompt, an alternative prompt wording and random instead of similarity-based example retrieval, six small models, $k \in \{1, 4\}$. Cells are means over the 12 runs, and $\Delta $ is paired over the 1,000 instances and 12 cells with its 95\% bootstrap interval. Ohsumed is Fixed only}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Supervised baselines against LLM pipelines, macro-F1. Supervised rows are means over three seeds, LLM rows over six models and three seeds. The fixed configuration is Per-Class retrieval at $k = 4$ (Ohsumed: Fixed, marked F). The best pipeline is the best (method, variant, $k$) mean per column and is selected on the test set and is exploratory. Zero-shot prompting does not depend on the pool. The test sample is identical at every imbalance level. Bold marks the best value per column.}}{19}{table.caption.29}\protected@file@percent }
\newlabel{tab:baselines}{{10}{19}{Supervised baselines against LLM pipelines, macro-F1. Supervised rows are means over three seeds, LLM rows over six models and three seeds. The fixed configuration is Per-Class retrieval at $k = 4$ (Ohsumed: Fixed, marked F). The best pipeline is the best (method, variant, $k$) mean per column and is selected on the test set and is exploratory. Zero-shot prompting does not depend on the pool. The test sample is identical at every imbalance level. Bold marks the best value per column}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Macro-F1 against the size of the labelled pool (training plus calibration, split 80/20). Supervised rows are means over three seeds, LLM rows over six models and three seeds, and the test sample is the same at every pool size. The best pipeline is selected on the test set, and is exploratory, among $k \in \{1, 4\}$ below 2,000 labels. Bold marks the best value per row. The RoBERTa-large rows are being rerun with a lower learning rate.}}{19}{table.caption.31}\protected@file@percent }
\newlabel{tab:pool}{{11}{19}{Macro-F1 against the size of the labelled pool (training plus calibration, split 80/20). Supervised rows are means over three seeds, LLM rows over six models and three seeds, and the test sample is the same at every pool size. The best pipeline is selected on the test set, and is exploratory, among $k \in \{1, 4\}$ below 2,000 labels. Bold marks the best value per row. The RoBERTa-large rows are being rerun with a lower learning rate}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Ablation of the embedding, the classifier and $\alpha $ with Llama-3.1-8B and Llama-3.2-3B, both retrieval variants, $k \in \{1, 4\}$ and three seeds (24 cells). Few-shot prompting retrieves with the same embedding as the CICLe run it is paired with. $\Delta $ = CICLe minus few-shot with its 95\% bootstrap interval. Coverage, set size and the share of instances answered without an LLM call describe the candidate sets.}}{19}{table.caption.32}\protected@file@percent }
\newlabel{tab:ablation}{{12}{19}{Ablation of the embedding, the classifier and $\alpha $ with Llama-3.1-8B and Llama-3.2-3B, both retrieval variants, $k \in \{1, 4\}$ and three seeds (24 cells). Few-shot prompting retrieves with the same embedding as the CICLe run it is paired with. $\Delta $ = CICLe minus few-shot with its 95\% bootstrap interval. Coverage, set size and the share of instances answered without an LLM call describe the candidate sets}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Mistral-NeMo-12B and Qwen2.5-32B with and without CICLe. Cells give few-shot / CICLe macro-F1, mean over the seeds listed. $\Delta $ = CICLe minus few-shot over $k \in \{1, 4\}$, paired within the model, with 95\% bootstrap intervals and the number of cells. The last rows compare the best 3B model with CICLe (Per-Class, $k = 4$) against the 32B model's zero-shot score on seed 42.}}{20}{table.caption.34}\protected@file@percent }
\newlabel{tab:large}{{13}{20}{Mistral-NeMo-12B and Qwen2.5-32B with and without CICLe. Cells give few-shot / CICLe macro-F1, mean over the seeds listed. $\Delta $ = CICLe minus few-shot over $k \in \{1, 4\}$, paired within the model, with 95\% bootstrap intervals and the number of cells. The last rows compare the best 3B model with CICLe (Per-Class, $k = 4$) against the 32B model's zero-shot score on seed 42}{table.caption.34}{}}
